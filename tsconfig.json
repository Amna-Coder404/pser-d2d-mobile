{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/app/_layout.jsx",
    "src/app/drafts.jsx",
    "src/app/index.jsx",
    "src/app/mySurveys.jsx",
    "src/app/survey.jsx"
  ]
}